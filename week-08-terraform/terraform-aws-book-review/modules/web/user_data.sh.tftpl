#!/bin/bash
set -euxo pipefail
exec > >(tee -a /var/log/web-userdata.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
export HOME=/root

fallocate -l 1G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile

apt-get update -y
apt-get install -y git nginx nodejs npm

git clone ${repo_url} /opt/book-review-app
cd /opt/book-review-app/frontend
echo "NEXT_PUBLIC_API_URL=http://${public_alb_dns}" > .env.production
npm install
npm run build

useradd --system --home /opt/book-review-app --shell /usr/sbin/nologin bookreview
chown -R bookreview:bookreview /opt/book-review-app

cat > /etc/systemd/system/book-review-frontend.service <<'UNIT'
[Unit]
Description=Book Review frontend
After=network.target

[Service]
User=bookreview
WorkingDirectory=/opt/book-review-app/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/nginx/sites-available/book-review <<'NGINX'
server {
    listen 80 default_server;
    server_name _;
    resolver ${vpc_resolver_ip} valid=30s;
    set $backend "${internal_alb_dns}";

    location /api/ {
        proxy_pass http://$backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(users|books|reviews)(/.*)?$ {
        rewrite ^/(.*)$ /api/$1 break;
        proxy_pass http://$backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
NGINX

rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/book-review /etc/nginx/sites-enabled/book-review
nginx -t

systemctl daemon-reload
systemctl enable --now book-review-frontend
systemctl enable nginx
systemctl restart nginx

echo "Book Review web tier ready"
